CORS_ALLOWED_METHODS=*
CORS_ALLOWED_ORIGINS=*
CORS_ALLOW_CREDENTIALS=false

DB_URL=jdbc:postgresql://<DB_HOST from database/.env>:5432/<POSTGRES_DB from database/.env>
DB_USERNAME=<POSTGRES_USER from database/.env>
DB_PASSWORD=<POSTGRES_PASSWORD from database/.env>

SPRING_PROFILES_ACTIVE=prod

ROUTING_BACKEND=solver
SOLVER_URL=http://solver:8090
SOLVER_HTTP_TIMEOUT_SECONDS=900
